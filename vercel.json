{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "buildCommand": "npm run check && npm run build",
  "crons": [
    {
      "path": "/api/cron/catalog",
      "schedule": "0 6 * * *"
    },
    { "path": "/api/cron/maintenance", "schedule": "0 7 * * *" }
  ]
}
