# Server only. The existing Gemini_API key name is also supported.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_ENABLED=true
AI_USER_DAILY_LIMIT=8
AI_GLOBAL_DAILY_LIMIT=100
LABS_ENABLED=true
LAB_USER_DAILY_LIMIT=2
LAB_GLOBAL_DAILY_LIMIT=10
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
APP_URL=http://localhost:3000
BILLING_LIVE_ENABLED=false

CRON_SECRET=
PUBLIC_SIGNUP_ENABLED=false
STRIPE_PORTAL_CONFIGURATION_ID=

# Publish these before opening public accounts or enabling real payments.
OPERATOR_NAME=
OPERATOR_EMAIL=
OPERATOR_POSTAL_ADDRESS=
OPERATOR_COUNTRY=
AI_RETENTION_DAYS=90
LAB_RETENTION_DAYS=90
USAGE_RETENTION_DAYS=90
STRIPE_EVENT_RETENTION_DAYS=90
OPERATIONS_RETENTION_DAYS=30
# Same value in Vercel production and GitHub Actions; never NEXT_PUBLIC_.
MONITOR_SECRET=
# Operations only: keep production DB/backup credentials out of normal dev env.
MIGRATION_DATABASE_URL=
PGSSLROOTCERT=
BACKUP_ENCRYPTION_KEY=
